# ── Docker Compose configuration ────────────────────────────────────────────
#
# Copy to `.env` in the repository root:
#
#   cp .env.example .env
#
# Compose reads this file automatically. Every value has a working local
# default, so `docker compose up` works without this file at all — you only
# need it to override something.
#
# For a real deployment, set at minimum JWT_SECRET and FRONTEND_ORIGIN.
# Never commit a filled-in copy of this file.

# Password for the local PostgreSQL container.
POSTGRES_PASSWORD=safe_password_here

# Signing key for auth tokens. Change this anywhere that is not a local
# developer machine. A short, predictable secret lets anyone forge a token
# and impersonate any account, including a driver.
JWT_SECRET=docker_jwt_secret_change_in_prod

# Origin the browser loads the frontend from. Must match exactly, including
# scheme, port and any sub-path, or the API will reject the request under
# CORS. Leave as-is for local development; set to the deployed frontend URL
# in production.
FRONTEND_ORIGIN=http://localhost:3000
