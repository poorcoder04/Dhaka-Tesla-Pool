# =============================================
# Dhaka Tesla Pool — Environment Variables
# Copy this file to backend/.env and fill in values.
# NEVER commit real secrets to git.
# =============================================

# --- Database ---
# Local dev (host machine connecting to Docker-exposed port):
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5433/tesla_pool_db?schema=public"
# Inside Docker containers (container-to-container):
# DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@postgres:5432/tesla_pool_db?schema=public"

# --- Auth ---
JWT_SECRET="replace_with_a_long_random_secret"

# --- Server ---
PORT=5000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:5000"
