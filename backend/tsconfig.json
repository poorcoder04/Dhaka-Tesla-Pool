{
  "compilerOptions": {
    // Output
    "outDir": "./dist",

    // Module system — ESM for Node 22
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",

    // Library / environment
    "lib": ["ES2022"],
    "types": ["node"],

    // Emit
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Strict checks
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,

    // Module detection
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force"
  },
  "include": ["src/**/*", "generated/**/*", "prisma/seed.ts"],
  "exclude": ["node_modules", "dist"]
}
