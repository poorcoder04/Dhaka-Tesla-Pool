NODE_ENV=development
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5433/tesla_pool_db?schema=public
JWT_SECRET=replace_with_a_long_random_secret_at_least_16_chars
JWT_EXPIRES_IN=7d
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Integration tests only. The suite TRUNCATES every table between cases, so it
# must point at the throwaway database from docker-compose.test.yml, never at
# DATABASE_URL above. globalSetup refuses to run if the two name the same
# database. Start it with: npm run test:db:up
TEST_DATABASE_URL=postgresql://postgres:test_password_here@localhost:5434/tesla_pool_test_db?schema=public